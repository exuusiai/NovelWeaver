# Run commands from the repository root. Copy to .env on the server.
HOST=127.0.0.1
PORT=4300
NOVELWEAVER_DATA_DIR=./.data/server

# Generation and semantic checking share the existing OpenAI-compatible gateway.
# Enable explicitly after the offline checks pass.
HARNESS_MODEL_ENABLED=0
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=

# Force lexical retrieval and disable Harness remote adapters for offline operation.
NOVELWEAVER_OFFLINE=1
